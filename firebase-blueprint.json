  "firestore": {
    "/admins/{adminUid}": {
      "schema": "AdminRecord",
      "description": "Elevated system administrator lookup collection."
    },
    "/workspaceSettings/{workspaceId}": {
      "schema": "WorkspaceSettings",
      "description": "ISP tenant system configuration keyed by ownerUid."
    },
    "/pops/{popId}": {
      "schema": "PopZone",
      "description": "Point of Presence and coverage zone records."
    },
    "/packages/{packageId}": {
      "schema": "IspPackage",
      "description": "ISP PPPoE, Hotspot, and Static IP tariff plans."
    },
    "/routers/{routerId}": {
      "schema": "MikrotikRouter",
