      "required": [
        "ownerUid", "ticketNo", "customerId", "customerUsername", "customerName",
        "contact", "email", "popName", "address", "customerBalance", "customerExpiry",
        "lockStatus", "issueType", "description", "assignedTo", "createdBy",
        "status", "priority", "lastComment", "smsSentCustomer", "smsSentStaff",
        "createdAt", "updatedAt"
      ]
