        "monthlyRate": { "type": "number" },
        "balance": { "type": "number" },
        "billingCycle": { "type": "string", "maxLength": 32 },
        "expiryDate": { "type": "string", "maxLength": 32 },
        "lockStatus": { "type": "string", "enum": ["Unlocked", "Locked"], "maxLength": 16 },
        "accountStatus": { "type": "string", "enum": ["Active", "Expired", "Disabled"], "maxLength": 16 },
        "category": { "type": "string", "enum": ["Regular", "VIP", "Free"], "maxLength": 16 },
        "planType": { "type": "string", "enum": ["Prepaid", "Postpaid"], "maxLength": 16 },
        "ipAddress": { "type": "string", "maxLength": 48 },
        "macAddress": { "type": "string", "maxLength": 32 },
        "mikrotikQueue": { "type": "string", "maxLength": 80 },
        "routerName": { "type": "string", "maxLength": 80 },
        "isOnline": { "type": "boolean" },
        "lastLogout": { "type": "string", "maxLength": 64 },
        "iRef": { "type": "string", "maxLength": 64 },
        "resellerId": { "type": "string", "maxLength": 128 },
        "fiberLength": { "type": "string", "maxLength": 32 },
        "cpeModel": { "type": "string", "maxLength": 80 },
        "oltPort": { "type": "string", "maxLength": 32 },
        "linkRemarks": { "type": "string", "maxLength": 200 },
        "avatarType": { "type": "string", "enum": ["male", "female"], "maxLength": 16 },
        "mobileVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "custId", "username", "password", "name", "mobile", "email",
        "address", "nidNumber", "popName", "zoneName", "packageId", "packageName",
        "monthlyRate", "balance", "billingCycle", "expiryDate", "lockStatus",
        "accountStatus", "category", "planType", "ipAddress", "macAddress",
        "mikrotikQueue", "routerName", "isOnline", "lastLogout", "iRef",
        "resellerId", "fiberLength", "cpeModel", "oltPort", "linkRemarks",
        "avatarType", "mobileVerified", "createdAt", "updatedAt"
      ]
    },
    "Reseller": {
