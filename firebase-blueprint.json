    "Employee": {
      "title": "Employee",
      "description": "ISP staff member with role, POP restriction, and allowed cash/bank entry channels.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 120 },
        "mobile": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["Super Admin", "Billing", "Support", "NOC", "Operations", "POP Manager"], "maxLength": 32 },
        "department": { "type": "string", "maxLength": 64 },
