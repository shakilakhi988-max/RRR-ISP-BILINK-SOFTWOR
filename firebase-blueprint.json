{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Elevated system administrator identity record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "ISP company configuration, payment sync, SMS gateway, and router sandbox preferences.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyName": { "type": "string", "maxLength": 120 },
        "companyCode": { "type": "string", "maxLength": 60 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 240 },
        "currency": { "type": "string", "maxLength": 12 },
        "bkashMerchant": { "type": "string", "maxLength": 40 },
        "rocketMerchant": { "type": "string", "maxLength": 40 },
        "nagadMerchant": { "type": "string", "maxLength": 40 },
        "paymentGatewayProvider": { "type": "string", "maxLength": 60 },
        "paymentGatewayEnabled": { "type": "boolean" },
        "smsSenderId": { "type": "string", "maxLength": 40 },
        "smsMasking": { "type": "boolean" },
        "smsBalance": { "type": "number" },
        "smsRate": { "type": "number" },
        "routerSandboxMode": { "type": "boolean" },
        "keeperAlertOnLogin": { "type": "boolean" },
        "btrcLicenseNo": { "type": "string", "maxLength": 80 },
        "seeded": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "companyName", "companyCode", "phone", "email", "address",
        "currency", "bkashMerchant", "rocketMerchant", "nagadMerchant",
        "paymentGatewayProvider", "paymentGatewayEnabled", "smsSenderId",
        "smsMasking", "smsBalance", "smsRate", "routerSandboxMode",
        "keeperAlertOnLogin", "btrcLicenseNo", "seeded", "createdAt", "updatedAt"
      ]
    },
    "PopZone": {
      "title": "PopZone",
      "description": "Point of Presence (POP) and coverage zone definition.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "code": { "type": "string", "maxLength": 32 },
        "zoneName": { "type": "string", "maxLength": 80 },
        "oltInfo": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 200 },
        "managerName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Active", "Maintenance", "Inactive"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "name", "code", "zoneName", "oltInfo", "address", "managerName", "status", "createdAt", "updatedAt"]
    },
    "IspPackage": {
      "title": "IspPackage",
      "description": "PPPoE, Hotspot, or Corporate bandwidth plan and MikroTik queue profile.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "planType": { "type": "string", "enum": ["Prepaid", "Postpaid", "Hotspot", "Corporate"], "maxLength": 20 },
        "serviceType": { "type": "string", "enum": ["PPPoE", "Hotspot", "Static IP"], "maxLength": 20 },
        "downloadMbps": { "type": "number" },
        "uploadMbps": { "type": "number" },
        "mikrotikQueue": { "type": "string", "maxLength": 80 },
        "monthlyRate": { "type": "number" },
        "resellerRate": { "type": "number" },
        "poolName": { "type": "string", "maxLength": 60 },
        "validityDays": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Archived"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "name", "planType", "serviceType", "downloadMbps", "uploadMbps",
        "mikrotikQueue", "monthlyRate", "resellerRate", "poolName", "validityDays",
        "status", "createdAt", "updatedAt"
      ]
    },
    "MikrotikRouter": {
      "title": "MikrotikRouter",
      "description": "MikroTik RouterOS NAS and RADIUS client configuration.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "host": { "type": "string", "maxLength": 80 },
        "apiPort": { "type": "number" },
        "username": { "type": "string", "maxLength": 60 },
        "popName": { "type": "string", "maxLength": 80 },
        "model": { "type": "string", "maxLength": 60 },
        "rosVersion": { "type": "string", "maxLength": 32 },
        "mode": { "type": "string", "enum": ["Sandbox", "Live"], "maxLength": 16 },
        "radiusSecret": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Active", "Connected", "Disconnected", "Testing", "Maintenance"], "maxLength": 20 },
        "activeSessions": { "type": "number" },
        "cpuLoad": { "type": "number" },
        "uptime": { "type": "string", "maxLength": 48 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "name", "host", "apiPort", "username", "popName", "model",
        "rosVersion", "mode", "radiusSecret", "status", "activeSessions",
        "cpuLoad", "uptime", "createdAt", "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
