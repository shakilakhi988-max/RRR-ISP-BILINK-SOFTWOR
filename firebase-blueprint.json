        "createdBy": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved", "Closed"], "maxLength": 20 },
        "priority": { "type": "string", "enum": ["Normal", "High", "Critical"], "maxLength": 16 },
        "lastComment": { "type": "string", "maxLength": 500 },
        "smsSentCustomer": { "type": "boolean" },
        "smsSentStaff": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
